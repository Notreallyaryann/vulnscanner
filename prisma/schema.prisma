generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



model Scan {
  id           String     @id @default(cuid())
  targetUrl    String
  email        String?
  authEmail    String?
  authPassword String?
  status       ScanStatus @default(PENDING)
  reconData    Json?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  findings    Finding[]
}

model GitHubScan {
  id            String     @id @default(cuid())
  repoFullName  String
  branch        String     @default("main")
  commitSha     String?
  enableLLM     Boolean    @default(true)
  status        ScanStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  findings      Finding[]
}

model Finding {
  id          String   @id @default(cuid())
  scanId      String?
  scan        Scan?    @relation(fields: [scanId], references: [id])
  gitHubScanId String?
  gitHubScan   GitHubScan? @relation(fields: [gitHubScanId], references: [id])
  type        String   // sqli, xss, csrf, idor, headers, redirect, secrets, lfi, cve
  severity    Severity
  url         String
  parameter   String?
  evidence    String?
  cvssScore   Float?
  cveId       String?
  // ── False-positive reduction ────────────────────────────────────────────
  confidence      Float    @default(0.85) // 0.0-1.0: how verified the finding is
  validationSteps Json?                   // proof trail of confirmation steps
  isVerified      Boolean  @default(false) // true = multi-step confirmed
  // RAG-generated fix
  title       String?
  explanation String?
  fixSteps    Json?
  codeExample String?
  // embedding for semantic search (optional – populated only when RAG search is enabled)
  embedding   Float[]  // pgvector
  createdAt   DateTime @default(now())
}


model KnowledgeChunk {
  id        String   @id @default(cuid())
  source    String   // "owasp", "nvd", "cwe"
  title     String
  content   String
  embedding Float[]  // pgvector
  createdAt DateTime @default(now())
}

enum ScanStatus {
  PENDING
  CRAWLING
  SCANNING
  ANALYZING
  COMPLETED
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}
